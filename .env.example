# Copy this file to `.env` and fill in your values.

# Google AI Studio API key — get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini text model. Examples: gemini-1.5-flash, gemini-flash-latest
MODEL=gemini-flash-latest

# Pace between LLM calls (seconds). Keeps you under free-tier 5 RPM.
PACE_SECS=13

# --- Optional: Google Maps MCP (hosted) ---
# Get a key in Google Cloud Console → APIs & Services → Credentials.
MAPS_API_KEY=

# --- Optional: BigQuery MCP (hosted) ---
# Requires: `gcloud auth application-default login` locally,
# and the BigQuery + Storage APIs enabled on your project.
GOOGLE_CLOUD_PROJECT=

# --- Gemini image generation ---
# Image model (Gemini image-preview or Imagen). Uses your GOOGLE_API_KEY above.
IMAGE_MODEL=gemini-2.5-flash-image-preview

# --- Persistence (both tools work with or without GCS) ---
# If GCS_BUCKET is set, images + posts are uploaded to that bucket.
# If left blank, they are written to ./out/ locally instead.
GCS_BUCKET=
# Override the local output directory if you want.
# LOCAL_OUT_DIR=./out
